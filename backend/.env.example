PORT=4000
NODE_ENV=development

# ─── PostgreSQL Database (Neon / Supabase / Local) ───────────────────────────
# For Neon, simply paste your Neon connection string:
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Alternatively, configure discrete variables:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hotel_menu

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_hotel_menu_2026
JWT_EXPIRES_IN=8h

# ─── Cloudinary Image Storage ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
